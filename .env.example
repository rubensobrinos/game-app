# Kopieer naar .env en vul in. .env staat in .gitignore en komt NOOIT in git
# (DEPLOYMENT-AND-TESTING.md: ".env.example bevat alleen sleutelnamen").

# PostgreSQL (analytics, alleen aggregaten)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gameapp:${POSTGRES_PASSWORD}@postgres:5432/gamestats

# Geheim voor token-/invite-hashing (PROTOCOL.md / room-codes).
# Genereer bijv. met: openssl rand -base64 48
TOKEN_PEPPER=

# Gepinde contentversie per match (ARCHITECTURE.md, principe 6)
CONTENT_VERSION=2026.08.1

# Alleen nodig met --profile tunnel (Cloudflare Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
