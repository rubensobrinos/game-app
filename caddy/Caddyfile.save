xxx\x\\zdfxxxxxxxxxxx# caddy/Caddyfile — fase 1. Routing conform docs/multiplayer/ARCHITECTURE.md:
#   /api/* en /socket.io/*  → game-server
#   al het overige          → frontend (nginx)
#
# Security-headers conform DEPLOYMENT-AND-TESTING.md. HSTS staat bewust nog
# UIT ("HSTS na succesvolle test") — inschakelen zodra HTTPS via de publieke
# route aantoonbaar goed werkt. Rate limiting op create/join vergt een
# Caddy-plugin of de echte game-server; staat als openstaand punt in
# docs/fase1-runbook.md.

(app) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# CSP: de bestaande app gebruikt inline scripts/styles en canvas;
		# aanscherpen kan pas na een echte inventarisatie van index.html.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'"
		# HSTS actief sinds 2 aug 2026 — publieke 4G-test door producteigenaar geslaagd.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	request_body {
		max_size 64KB
	}

	# ── Eén domein, één game ──────────────────────────────────────────
	# De game-server bedient de multiplayer: API, sockets, de multiplayer-
	# schermen (/j/, /game/, /host/) én hun assets (frontend/-root, /client/,
	# /shared/). nginx bedient de singleplayer op / (incl. flags/, waar ook de
	# multiplayer-spelschermen hun vlagafbeeldingen vandaan halen).
	handle /api/* {
		reverse_proxy game-server:3000
	}

	handle /socket.io/* {
		reverse_proxy game-server:3000
	}

	handle /j/* {
		reverse_proxy game-server:3000
	}

	handle /game/* {
		reverse_proxy game-server:3000
	}

	handle /host/* {
		reverse_proxy game-server:3000
	}

	handle /samen {
		reverse_proxy game-server:3000
	}

	# Assets van de multiplayer-frontend (frontend/ is de root van de
	# game-server; deze prefixen bestaan niet in de singleplayer):
	handle /css/* {
		reverse_proxy game-server:3000
	}

	handle /js/* {
		reverse_proxy game-server:3000
	}

	handle /vendor/* {
		reverse_proxy game-server:3000
	}

	handle /locales/* {
		reverse_proxy game-server:3000
	}

	handle /client/* {
		reverse_proxy game-server:3000
	}

	handle /shared/* {
		reverse_proxy game-server:3000
	}

	# ── Hoofdpagina = Rounda (besluit producteigenaar 3 aug 2026: één
	# voordeur). Exact "/" gaat naar de game-server, die de Rounda-home
	# (frontend/index.html) serveert. De oude singleplayer-menupagina blijft
	# bereikbaar op /solo; alle singleplayer-ASSETS (app.js, style.css,
	# flags/, losse spelbestanden) blijven via de catch-all hieronder gewoon
	# op hun bestaande rootpaden werken — alleen de indexpagina verhuist.
	handle / {
		reverse_proxy game-server:3000
	}

	handle /solo {
		rewrite * /index.html
		reverse_proxy frontend:80
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Publieke route. Achter Cloudflare Tunnel praat cloudflared intern HTTP met
# Caddy; TLS ligt dan aan de edge bij Cloudflare.
http://play.aseso.nl {
	import app
}

# Lokaal testen op de Mac zelf (http://localhost).
http://localhost, http://127.0.0.1 {
	import app
}
