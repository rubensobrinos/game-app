{
  "permissions": {
    "allow": [
      "Bash(devkit:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Edit(infra/prod/**)",
      "Write(infra/prod/**)",
      "Edit(.github/workflows/deploy.yml)",
      "Write(.github/workflows/deploy.yml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "devkit check-autonomy --staged --agent"
          }
        ]
      }
    ]
  }
}
